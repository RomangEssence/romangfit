@using romangfit.Models

<div class="card workout-card mb-3 border-0 shadow-sm rounded-4">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold m-0 text-dark">
                <span class="text-primary me-2">@Index</span>@Exercise.Category | @Exercise.Name
            </h6>
            <div class="dropdown">
                <button class="btn btn-link text-muted p-0" type="button">⋮</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            @if (Exercise.IsCardio)
            {
                <span class="small text-muted">총 시간 @TotalCardioTime 분</span>
            }
            else
            {
                <span class="small text-muted">총 볼륨 <strong class="text-dark">@TotalVolume kg</strong></span>
            }
            <button class="btn btn-light btn-sm text-secondary border rounded-pill px-2 py-0" style="font-size:11px;">최근 기록</button>
        </div>

        <input type="text" class="form-control memo-input mb-3" placeholder="메모" @bind="Exercise.Memo" />

        <div class="row g-2 text-center text-muted mb-2 small fw-bold">
            <div class="col-2">세트</div>
            <div class="col-4">@(Exercise.IsCardio ? "시간" : "kg")</div>
            <div class="col-3">@(Exercise.IsCardio ? "-" : "회")</div>
            <div class="col-3">완료</div>
        </div>

        @foreach (var set in Exercise.Sets)
        {
            <div class="row g-2 align-items-center text-center mb-2">
                <div class="col-2">
                    <span class="badge rounded-pill bg-light text-secondary w-100 py-2">@set.SetNumber</span>
                </div>
                <div class="col-4">
                    @if (Exercise.IsCardio)
                    {
                        <input type="text" class="form-control form-control-sm text-center border-0 bg-light rounded-3 fw-bold"
                               value="@set.Duration.ToString(@"hh\:mm\:ss")" disabled />
                    }
                    else
                    {
                        <input type="number" class="form-control form-control-sm text-center border-0 bg-light rounded-3 fw-bold" @bind="set.Weight" />
                    }
                </div>
                <div class="col-3">
                    @if (!Exercise.IsCardio)
                    {
                        <input type="number" class="form-control form-control-sm text-center border-0 bg-light rounded-3 fw-bold" @bind="set.Reps" />
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
                <div class="col-3">
                    <button class="btn btn-sm w-100 rounded-3 border-0 transition-all @(set.IsCompleted ? "btn-success-burn text-white" : "btn-light-check text-muted")"
                            @onclick="() => ToggleSet(set)">
                        ✓
                    </button>
                </div>
            </div>
        }

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-link text-danger text-decoration-none small p-0 flex-fill text-center" @onclick="RemoveLastSet">— 세트삭제</button>
            <button class="btn btn-link text-primary text-decoration-none small p-0 flex-fill text-center" @onclick="AddNewSet">+ 세트추가</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Exercise Exercise { get; set; } = new();
    [Parameter] public int Index { get; set; }
    [Parameter] public EventCallback<bool> OnSetCompleted { get; set; }

    private double TotalVolume => Exercise.Sets.Where(s => s.IsCompleted).Sum(s => s.Weight * s.Reps);
    private double TotalCardioTime => Exercise.Sets.Where(s => s.IsCompleted).Sum(s => s.Duration.TotalMinutes);

    private void ToggleSet(SetLog set)
    {
        set.IsCompleted = !set.IsCompleted;
        if (set.IsCompleted)
        {
            OnSetCompleted.InvokeAsync(true);
        }
    }

    private void AddNewSet()
    {
        var last = Exercise.Sets.LastOrDefault();
        Exercise.Sets.Add(new SetLog
        {
            SetNumber = Exercise.Sets.Count + 1,
            Weight = last?.Weight ?? 40,
            Reps = last?.Reps ?? 12,
            Duration = last?.Duration ?? TimeSpan.FromMinutes(10)
        });
    }

    private void RemoveLastSet()
    {
        if (Exercise.Sets.Count > 1)
        {
            Exercise.Sets.RemoveAt(Exercise.Sets.Count - 1);
        }
    }
}