@inject Services.WorkoutStateService State

<div class="view-panel animated-fade d-flex flex-column justify-content-between" style="height: 100%;">
    <div class="flex-fill" style="overflow-y: auto; padding-bottom: 80px; scrollbar-width: none;">
        <div class="d-flex justify-content-between align-items-center p-3">
            <div class="d-flex align-items-center gap-1">
                <span>🔥</span>
                <strong class="text-dark fs-5">@State.WorkoutHistory.Count</strong> @* 🌟 실제 누적 운동 일수가 스트릭이 됩니다 *@
            </div>
            <span class="badge bg-burn-blue text-white rounded-pill px-3 py-2 fw-bold shadow-sm" style="font-size: 11px;">B. PRO</span>
            <div class="text-muted d-flex gap-3 fs-5"><span>📅</span><span>🔔</span></div>
        </div>

        <div class="d-flex justify-content-around text-center px-2 py-3 bg-white rounded-4 mx-3 my-2 shadow-xs">
            @for (int i = -3; i <= 3; i++)
            {
                var day = DateTime.Today.AddDays(i);
                bool isToday = day == DateTime.Today;
                // 💡 내 운동 기록 중 해당 날짜에 완료한 운동이 있는지 검사해서 하단 점 인디케이터 활성화
                bool hasWorkout = State.WorkoutHistory.Any(h => h.Date.Date == day.Date);

                <div class="calendar-day-cell @(isToday ? "active" : "")">
                    <span class="day-name">@day.ToString("ddd")</span>
                    <span class="day-number">@day.Day</span>
                    @if (hasWorkout)
                    {
                        <span class="dot-indicator">.</span>
                    }
                </div>
            }
        </div>

        <div class="bg-white rounded-4 mx-3 my-4 p-4 text-center shadow-sm border border-light">
            <button class="btn btn-burn-primary w-100 py-3 rounded-3 fw-bold fs-6 shadow-sm"
                    @onclick='() => State.ChangeView("RoutineSelect")'>
                새 운동 기록하기
            </button>
        </div>

        <div class="px-3">
            <h6 class="fw-bold text-dark mb-3" style="font-size: 14px;">최근 운동 일지</h6>
            @if (!State.WorkoutHistory.Any())
            {
                <p class="text-muted small text-center py-4 bg-white rounded-4 border border-dashed">아직 저장된 운동 기록이 없습니다.</p>
            }
            else
            {
                @foreach (var log in State.WorkoutHistory.AsEnumerable().Reverse())
                {
                    <div class="card border-0 bg-white rounded-4 p-3 mb-2 shadow-xs">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="text-dark" style="font-size:14px;">🏋️ @log.RoutineName</strong>
                            <span class="text-muted" style="font-size:11px;">@log.Date.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div style="font-size:12px; color:#666;">
                            @foreach (var ex in log.Exercises)
                            {
                                <div class="mb-1">• @ex.Name <span class="text-burn-blue fw-bold">@ex.Sets.Count 세트</span> 완료</div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .bg-burn-blue {
        background-color: #2F80ED !important;
    }

    .text-burn-blue {
        color: #2F80ED !important;
    }

    .btn-burn-primary {
        background-color: #2F80ED;
        color: white;
        border: none;
    }

    .calendar-day-cell {
        padding: 6px;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 40px;
    }

        .calendar-day-cell.active {
            background-color: #2F80ED;
            color: white !important;
        }

        .calendar-day-cell .day-name {
            font-size: 10px;
            color: #828282;
        }

        .calendar-day-cell.active .day-name {
            color: #E0E0E0;
        }

        .calendar-day-cell .day-number {
            font-size: 14px;
            font-weight: bold;
        }

        .calendar-day-cell .dot-indicator {
            font-size: 14px;
            line-height: 2px;
            color: #2F80ED;
            font-weight: bold;
        }

        .calendar-day-cell.active .dot-indicator {
            color: white;
        }

    .border-dashed {
        border-style: dashed !important;
    }

    .shadow-xs {
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }
</style>