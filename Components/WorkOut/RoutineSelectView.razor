@inject Services.WorkoutStateService State

<div class="view-panel dark-theme-bg w-100 h-100 m-0">
    <!-- 상단 헤더 영역 (Safe Area 반영) -->
    <div class="header-zone d-flex align-items-center justify-content-between px-3 mb-2">
        <span class="fs-4 cursor-pointer text-light-gray select-none touch-target" @onclick='() => State.ChangeView("Dashboard")'>‹</span>
        <h5 class="fw-bold m-0 text-white">@DateTime.Today.ToString("M월 d일")</h5>
        <span class="fs-4 cursor-pointer text-neon fw-bold hover-glow select-none touch-target" @onclick="State.StartNewRoutineCreation">＋</span>
    </div>

    <!-- 네비게이션 탭 (압착 방지 및 고정) -->
    <div class="tab-header-zone d-flex text-center border-bottom-dark px-3 mb-3">
        <div class="flex-fill pb-2 text-muted-gray cursor-pointer" @onclick="State.StartNewEmptyWorkout">직접 추가</div>
        <div class="flex-fill pb-2 text-neon border-bottom border-neon border-3 fw-bold">내 루틴</div>
        <div class="flex-fill pb-2 text-muted-gray cursor-not-allowed">불러오기</div>
    </div>

    <!-- 루틴 요약 정보 -->
    <div class="summary-zone d-flex justify-content-between align-items-center text-muted-gray px-3 mb-3">
        <span>전체 @State.Routines.Count 개</span>
        <span>최근 저장순 ▾</span>
    </div>

    <!-- 루틴 리스트 스크롤 영역 (하단 패딩 여유 있게 확보) -->
    <div class="scroll-container px-3">
        @if (!State.Routines.Any())
        {
            <div class="text-center py-5 text-muted-gray">
                등록된 루틴이 없습니다. 우측 상단의 ＋ 버튼을 눌러 새 루틴을 생성해 보세요!
            </div>
        }
        else
        {
            @foreach (var routine in State.Routines)
            {
                var rId = routine.Id;
                var currentRoutine = routine; // 스코프 락
                <div class="swipe-container position-relative mb-3 overflow-hidden rounded-4">
                    <!-- 스와이프 삭제 액션 -->
                    <div class="swipe-delete-action bg-danger d-flex align-items-center px-4 position-absolute start-0 top-0 h-100 cursor-pointer @(swipedRoutineId == rId ? "active" : "")"
                         @onclick="() => State.DeleteRoutineAsync(rId)">
                        <span class="text-white small fw-bold">루틴<br />삭제</span>
                    </div>

                    <!-- 루틴 카드 본체 -->
                    <div class="card premium-card border-0 m-0 position-relative transition-transform cursor-pointer @(swipedRoutineId == rId ? "swiped" : "")"
                         style="z-index: 10;"
                         @onpointerdown="(e) => PointerDown(e)"
                         @onpointerup="(e) => HandlePointerUp(e, rId)">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="text-start">
                                <h6 class="fw-bold text-white mb-1">@currentRoutine.Name</h6>
                                <p class="text-muted-gray small m-0" style="font-size: 11px;">@currentRoutine.TargetSummary</p>
                            </div>
                            <span class="badge bg-neon-soft text-neon px-2.5 py-1 rounded-2 fw-bold flex-shrink-0" style="font-size:11px;">
                                운동 @(currentRoutine.Exercises?.Count ?? 0)개
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    /* 전체 뷰 패널을 모바일 화면 레이아웃으로 격리 */
    .view-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

    /* 상단 헤더존 - 아이폰 노치(상단 상태바) 대응 */
    .header-zone {
        height: calc(45px + env(safe-area-inset-top));
        padding-top: env(safe-area-inset-top);
        flex-shrink: 0;
    }

    /* 탭 메뉴 - 절대 찌그러지지 않도록 고정 */
    .tab-header-zone {
        height: 35px;
        flex-shrink: 0;
    }

    .summary-zone {
        font-size: 13px;
        flex-shrink: 0;
    }

    /* 스크롤 영역만 독립 구동 (하단 내비바와 아이폰 홈바 영역만큼 충분히 패딩 부여) */
    .scroll-container {
        flex: 1;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: calc(90px + env(safe-area-inset-bottom)) !important;
    }

        .scroll-container::-webkit-scrollbar {
            display: none;
        }

    .dark-theme-bg {
        background-color: var(--bg-dark) !important;
    }

    .text-light-gray {
        color: #A0AEC0 !important;
    }

    .text-muted-gray {
        color: var(--text-muted) !important;
    }

    .text-neon {
        color: var(--neon-green) !important;
    }

    .border-neon {
        border-color: var(--neon-green) !important;
    }

    .bg-neon-soft {
        background-color: var(--neon-green-glow) !important;
        border: 1px solid rgba(0, 102, 255, 0.15);
    }

    .border-bottom-dark {
        border-bottom: 1px solid var(--border-light);
    }

    .swipe-container {
        min-height: 80px;
        background-color: rgba(255, 77, 77, 0.05);
        flex-shrink: 0;
    }

    .swipe-delete-action {
        width: 85px;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.15s;
        border-radius: 16px 0 0 16px;
    }

        .swipe-delete-action.active {
            opacity: 1;
        }

    .transition-transform {
        transition: transform 0.25s cubic-bezier(0.1, 0.8, 0.1, 1);
    }

    .premium-card.swiped {
        transform: translateX(85px);
    }

    .hover-glow:hover {
        text-shadow: 0 0 8px var(--neon-green-glow);
        transform: scale(1.1);
    }

    .cursor-not-allowed {
        cursor: not-allowed;
        opacity: 0.4;
    }

    .select-none {
        user-select: none;
        -webkit-user-select: none;
    }

    /* 터치 영역 강제 확장 클래스 */
    .touch-target {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .touch-target::after {
            content: '';
            position: absolute;
            top: -18px;
            bottom: -18px;
            left: -18px;
            right: -18px;
        }
</style>

@code {
    private string swipedRoutineId = "";
    private double startX = 0;

    private void PointerDown(PointerEventArgs e) => startX = e.ClientX;

    private void HandlePointerUp(PointerEventArgs e, string id)
    {
        if (startX == 0) return;
        var deltaX = e.ClientX - startX;
        startX = 0;

        if (deltaX > 50)
        {
            swipedRoutineId = id;
        }
        else if (deltaX < -30 && swipedRoutineId == id)
        {
            swipedRoutineId = "";
        }
        else if (Math.Abs(deltaX) <= 15)
        {
            if (swipedRoutineId == id)
            {
                swipedRoutineId = "";
            }
            else
            {
                var target = State.Routines.FirstOrDefault(r => r.Id == id);
                if (target != null) State.PreviewRoutine(target);
            }
        }
    }
}