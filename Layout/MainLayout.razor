@inherits LayoutComponentBase

<div class="blazor-custom-reset app-layout-root">
    @Body
</div>

<style>
    /* 1. 레이아웃 루트를 모바일 화면 및 PWA 독립 실행형 크기에 맞게 강제 고정 */
    .app-layout-root {
        width: 100vw;
        /* dvh를 지원하지 않는 브라우저 대응용 fallback */
        height: 100vh;
        /* 상하단 바를 감안한 실제 모바일 동적 뷰포트 높이 100% */
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
        background-color: var(--bg-dark, #FFFFFF);
    }

    /* 2. PC 또는 가로가 넓은 화면에서 볼 때도 가운데 정렬 및 폰 쉘 유지 (선택 사항) */
    @media (min-width: 501px) {
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #EDF2F7; /* PC 배경색 */
        }

        .app-layout-root {
            width: 420px;
            height: 860px;
            border-radius: 48px;
            border: 12px solid #0F172A;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.15);
        }
    }

    /* Blazor 기본 템플릿의 사이드바 및 레이아웃 초기화 */
    .page {
        display: block !important;
        flex-direction: unset !important;
    }

    main {
        width: 100% !important;
        height: 100% !important;
    }

    .sidebar {
        display: none !important;
    }

    body {
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
</style>