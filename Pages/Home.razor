@page "/"
@inject Services.WorkoutStateService State
@using romangfit.Models
@implements IDisposable

<div class="burnfit-shell">
    @if (State.CurrentViewState == "Dashboard")
    {
        <div class="view-panel pb-5">
            <div class="d-flex justify-content-between align-items-center p-3">
                <span class="fs-4 fw-bold text-dark">🔥 1</span>
                <span class="badge bg-primary-burn rounded-pill px-3 py-2 fw-bold text-white shadow-sm" style="font-size:12px;">B. PRO</span>
                <div class="text-muted fs-4">📅 🔔</div>
            </div>

            <div class="d-flex justify-content-around text-center p-2 mb-4 bg-white border-bottom">
                @for (int i = -3; i <= 3; i++)
                {
                    var day = DateTime.Today.AddDays(i);
                    <div class="p-2 rounded-circle @(day == DateTime.Today ? "bg-primary-burn text-white px-3" : "text-muted")">
                        <small style="font-size:10px d-block;">@day.ToString("ddd")</small><br />
                        <strong style="font-size:14px;">@day.Day</strong>
                    </div>
                }
            </div>

            <div class="text-center my-5 py-4">
                <div class="text-muted fs-1 mb-2">🏋️‍♂️</div>
                <h6 class="fw-bold text-dark">계획된 운동이 없어요</h6>
                <p class="text-muted small">지금 바로 운동을 계획해보세요!</p>
                <button class="btn btn-primary-burn w-75 py-3 rounded-4 fw-bold fs-6 mt-3 shadow-sm" @onclick='() => State.ChangeViewState("RoutineSelect")'>
                    운동 기록하기
                </button>
                <div class="mt-3"><button class="btn btn-link text-muted text-decoration-none small">휴식 모드</button></div>
            </div>

            <div class="card mx-3 border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">🍽️ 식단</span>
                    <span class="text-muted">＞</span>
                </div>
                <h4 class="fw-bold my-2">0 <span class="fs-6 text-muted fw-normal">kcal</span></h4>
                <div class="progress rounded-pill mb-3" style="height:8px;"><div class="progress-bar bg-light w-100"></div></div>
                <div class="row text-center g-2 small text-muted">
                    <div class="col-3 bg-light p-2 rounded-3">☀️ 아침</div>
                    <div class="col-3 bg-light p-2 rounded-3">🌤️ 점심</div>
                    <div class="col-3 bg-light p-2 rounded-3">🌙 저녁</div>
                    <div class="col-3 bg-light p-2 rounded-3">🍬 간식</div>
                </div>
            </div>
        </div>
    }
    else if (State.CurrentViewState == "RoutineSelect")
    {
        <div class="view-panel p-3">
            <div class="d-flex align-items-center mb-4">
                <button class="btn btn-link text-dark fs-4 p-0 me-3 text-decoration-none" @onclick='() => State.ChangeViewState("Dashboard")'>＜</button>
                <h5 class="fw-bold m-0 flex-fill text-center">5월 31일</h5>
                <button class="btn btn-link text-dark fs-4 p-0 text-decoration-none" @onclick="State.StartNewEmptyWorkout">＋</button>
            </div>
            <div class="d-flex border-bottom text-center mb-3">
                <div class="flex-fill pb-2 text-muted" @onclick='() => State.ChangeViewState("ExerciseSearch")'>직접 추가</div>
                <div class="flex-fill pb-2 text-primary border-bottom border-primary border-3 fw-bold">내 루틴</div>
                <div class="flex-fill pb-2 text-muted">불러오기</div>
            </div>
            <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                <span>전체 @MockRoutines.Count 개</span>
                <span>최근 저장순 🔻</span>
            </div>

            @foreach (var routine in MockRoutines)
            {
                <div class="card border-0 bg-light rounded-4 p-3 mb-2 shadow-xs cursor-pointer transition-all hover-scale" @onclick="() => State.PreviewRoutine(routine)">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold text-dark mb-1">@routine.Name</h6>
                            <small class="text-muted">@routine.TargetSummary</small><br />
                            <small class="text-black-50" style="font-size:11px;">2026년 5월 31일</small>
                        </div>
                        <span class="badge bg-soft-blue text-primary px-2 py-1 rounded-3">✓ @routine.Exercises.Count</span>
                    </div>
                </div>
            }
        </div>
    }
    else if (State.CurrentViewState == "ExerciseSearch")
    {
        <div class="view-panel p-3">
            <div class="d-flex align-items-center mb-3">
                <button class="btn btn-link text-dark fs-4 p-0 me-3 text-decoration-none" @onclick='() => State.ChangeViewState("RoutineSelect")'>＜</button>
                <h5 class="fw-bold m-0 flex-fill text-center">5월 31일</h5>
            </div>
            <div class="search-box mb-3 position-relative">
                <input type="text" class="form-control rounded-pill border-0 bg-light ps-4" placeholder="찾으시는 운동을 검색해보세요." />
                <span class="position-absolute end-0 top-50 translate-middle-y me-3">🔍</span>
            </div>
            <div class="d-flex gap-2 overflow-auto pb-2 mb-3 no-scrollbar" style="white-space: nowrap;">
                <span class="badge rounded-pill bg-dark px-3 py-2">🔖</span>
                <span class="badge rounded-pill bg-light text-dark px-3 py-2 border">전체</span>
                <span class="badge rounded-pill bg-light text-dark px-3 py-2 border">하체</span>
                <span class="badge rounded-pill bg-light text-dark px-3 py-2 border">가슴</span>
                <span class="badge rounded-pill bg-light text-dark px-3 py-2 border">등</span>
                <span class="badge rounded-pill bg-light text-dark px-3 py-2 border">어깨</span>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var ex in FlatExercisePool)
                {
                    <label class="list-group-item border-0 d-flex align-items-center gap-3 py-3 px-1 cursor-pointer">
                        <input type="checkbox" class="form-check-input burn-checkbox" 
                               checked="@State.CheckedExercisesForAdd.Contains(ex)"
                               @onchange="(e) => OnExerciseChecked(ex, e.Value)" />
                        <div class="exercise-avatar bg-light rounded-circle text-center d-flex align-items-center justify-content-center" style="width:45px; height:45px;">
                            @ex.IconPlaceholder
                        </div>
                        <div class="flex-fill">
                            <span class="small text-muted d-block" style="font-size:11px;">@ex.Category</span>
                            <span class="fw-bold text-dark">@ex.Name</span>
                        </div>
                    </label>
                }
            </div>

            @if (State.CheckedExercisesForAdd.Any())
            {
                <div class="fixed-bottom max-w-500 bg-white p-3 border-top shadow-lg d-flex gap-2">
                    <button class="btn btn-light border rounded-3 px-3">＋</button>
                    <button class="btn btn-primary-burn flex-fill py-3 rounded-3 fw-bold" @onclick="State.ConfirmAddExercises">
                        @State.CheckedExercisesForAdd.Count 개의 운동 추가하기
                    </button>
                </div>
            }
        </div>
    }
    else if (State.CurrentViewState == "RoutinePreview")
    {
        <div class="view-panel p-3 bg-white container-sheet">
            <div class="d-flex justify-content-between border-bottom pb-2 mb-3">
                <h5 class="fw-bold m-0">@State.SelectedRoutinePreview?.Name</h5>
                <button class="btn-close" @onclick='() => State.ChangeViewState("RoutineSelect")'></button>
            </div>
            <div class="overflow-auto" style="max-height: 60vh;">
                @foreach (var ex in State.SelectedRoutinePreview?.Exercises ?? new())
                {
                    <div class="d-flex align-items-center gap-3 py-2 border-bottom border-light">
                        <div class="fs-3">@ex.IconPlaceholder</div>
                        <div class="flex-fill">
                            <h6 class="fw-bold text-dark m-0">@ex.Name</h6>
                            <small class="text-muted">@ex.Category | @ex.Sets.Count 세트</small>
                        </div>
                        <span class="text-muted">＞</span>
                    </div>
                }
            </div>
            <button class="btn btn-primary-burn w-100 py-3 rounded-4 fw-bold fs-5 mt-4" @onclick="State.StartWorkoutFromRoutine">
                운동 시작하기
            </button>
        </div>
    }
    else if (State.CurrentViewState == "ActiveLogging")
    {
        <div class="view-panel bg-light-gray p-3 pb-5 mb-5">
            <div class="d-flex align-items-center mb-3">
                <button class="btn btn-link text-dark fs-4 p-0 me-3 text-decoration-none" @onclick='() => State.ChangeViewState("RoutineSelect")'>＜</button>
                <h5 class="fw-bold m-0 flex-fill text-center">5월 31일</h5>
                <div class="text-muted fs-4">📅 ☰</div>
            </div>

            @if (State.ActiveWorkout != null)
            {
                for (int i = 0; i < State.ActiveWorkout.Exercises.Count; i++)
                {
                    var index = i + 1;
                    <ExerciseCard Exercise="State.ActiveWorkout.Exercises[i]" Index="index" OnSetCompleted="OnSetCompletedSound" />
                }
            }

            <div class="fixed-bottom max-w-500 bg-white p-3 border-top shadow-lg">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <button class="btn flex-fill py-2 rounded-3 text-center border @(isTimerOn ? "btn-soft-blue text-primary border-primary":"bg-light")" @onclick="ToggleRestTimer">
                        <small class="d-block text-muted" style="font-size:9px;">휴식 타이머</small>
                        <strong style="font-size:13px;">@(isTimerOn ? "ON" : "OFF")</strong>
                    </button>
                    <div class="btn bg-light flex-fill py-2 rounded-3 text-center border-0">
                        <small class="d-block text-muted" style="font-size:9px;">운동 시간</small>
                        <strong style="font-size:13px;">@elapsedTime.ToString(@"hh\:mm\:ss")</strong>
                    </div>
                </div>
                <button class="btn btn-primary-burn w-100 py-3 rounded-3 fw-bold fs-5" @onclick="State.CompleteWorkout">
                    운동 완료
                </button>
            </div>
        </div>
    }
</div>

<style>
    .burnfit-shell { max-width: 500px; margin: 0 auto; min-height: 100vh; background-color: #ffffff; font-family: -apple-system, sans-serif; position: relative; color: #333333; }
    .view-panel { width: 100%; min-height: 100vh; animation: fadeIn 0.2s ease-in-out; }
    .bg-primary-burn { background-color: #2F80ED !important; }
    .btn-primary-burn { background-color: #2F80ED; color: white; border: none; transition: background 0.2s; }
    .btn-primary-burn:hover { background-color: #1b66ca; color: white; }
    .bg-light-gray { background-color: #F6F8FA; }
    .bg-soft-blue { background-color: #EBF3FF; }
    .btn-soft-blue { background-color: #EBF3FF !important; }
    .text-primary { color: #2F80ED !important; }
    .form-control:focus { box-shadow: none; border-color: #2F80ED; }
    .memo-input { border: 0; background-color: #F6F8FA; font-size: 13px; padding: 8px 12px; border-radius: 8px; }
    .btn-light-check { background-color: #F2F4F7; color: #D0D5DD; }
    .btn-success-burn { background-color: #2F80ED !important; }
    .burn-checkbox { width: 22px; height: 22px; border-radius: 6px; border: 2px solid #D0D5DD; }
    .burn-checkbox:checked { background-color: #2F80ED; border-color: #2F80ED; }
    .max-w-500 { max-width: 500px; left: 50% !important; transform: translateX(-50%); }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .cursor-pointer { cursor: pointer; }
    .transition-all { transition: all 0.2s ease-in-out; }
    .hover-scale:hover { transform: translateY(-2px); }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    private bool isTimerOn = true;
    private TimeSpan elapsedTime = TimeSpan.Zero;
    private System.Threading.Timer? globalTimer;

    protected override void OnInitialized()
    {
        State.OnStateChanged += StateHasChanged;
        
        // 실시간 가상 운동 타이머 구동
        globalTimer = new System.Threading.Timer((s) => {
            if (State.CurrentViewState == "ActiveLogging")
            {
                elapsedTime = elapsedTime.Add(TimeSpan.FromSeconds(1));
                InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1000);
    }

    private void OnExerciseChecked(Exercise ex, object? checkedValue)
    {
        bool isChecked = checkedValue is bool b && b;
        if (isChecked)
        {
            if (!State.CheckedExercisesForAdd.Contains(ex))
                State.CheckedExercisesForAdd.Add(ex);
        }
        else
        {
            State.CheckedExercisesForAdd.Remove(ex);
        }
    }

    private void ToggleRestTimer() => isTimerOn = !isTimerOn;
    private void OnSetCompletedSound(bool isComplete) { /* 향후 햅틱 알림 또는 카운트다운 트리거 스텁 */ }

    public void Dispose()
    {
        State.OnStateChanged -= StateHasChanged;
        globalTimer?.Dispose();
    }

    // ==========================================
    // MOCK SEED DATA SECTIONS (데이터 풀 정의)
    // ==========================================
    private List<Exercise> FlatExercisePool => new()
    {
        new() { Name = "케이블 푸시 다운", Category = "팔", IconPlaceholder = "💪" },
        new() { Name = "리어 델토이드 플라이 머신", Category = "어께", IconPlaceholder = "🦅" },
        new() { Name = "레터럴 와이드 풀다운", Category = "등", IconPlaceholder = "👐" },
        new() { Name = "원암 레터럴 와이드 풀다운", Category = "등", IconPlaceholder = "🧍" },
        new() { Name = "하이 로우 머신", Category = "등", IconPlaceholder = "🚣" },
        new() { Name = "싸이클", Category = "유산소", IconPlaceholder = "🚴", IsCardio = true }
    };

    private List<WorkoutRoutine> MockRoutines => new()
    {
        new() { 
            Name = "하체", 
            TargetSummary = "유산소 · 하체",
            Exercises = new() {
                new() { Name = "싸이클", Category = "유산소", IsCardio = true, IconPlaceholder = "🚴", Sets = new() { new() { SetNumber = 1 } } },
                new() { Name = "시티드 레그 컬", Category = "하체", IconPlaceholder = "🦵", Sets = new() { new(){SetNumber=1}, new(){SetNumber=2}, new(){SetNumber=3} } },
                new() { Name = "힙 어덕션 머신", Category = "하체", IconPlaceholder = "🍑", Sets = new() { new(){SetNumber=1}, new(){SetNumber=2}, new(){SetNumber=3} } },
                new() { Name = "수평 레그 프레스", Category = "하체", IconPlaceholder = "🏋️", Sets = new() { new(){SetNumber=1}, new(){SetNumber=2}, new(){SetNumber=3}, new(){SetNumber=4} } }
            }
        },
        new() { Name = "등 이두", TargetSummary = "유산소 · 등 · 어깨 · 팔" },
        new() { Name = "가슴 어깨 삼두", TargetSummary = "유산소 · 가슴 · 어깨 · 팔" }
    };
}